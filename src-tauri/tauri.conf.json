{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeReel",
  "version": "0.1.0",
  "identifier": "com.movies.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HomeReel",
        "decorations": false,
        "width": 1280,
        "height": 720,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://*.tmdb.org https://*.themoviedb.org; img-src 'self' asset: http://asset.localhost https://*.tmdb.org https://*.themoviedb.org https://img.youtube.com https://i.ytimg.com; frame-src 'self' https://www.youtube.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}